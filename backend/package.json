{
  "name": "sentinelle-mcp-backend",
  "version": "1.0.0",
  "description": "Backend API pour la plateforme Sentinelle-MCP",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
